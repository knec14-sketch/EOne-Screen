# Миниатюра темы для витрины: программа рисует её сама, и на ней
# видно железо той машины, где она нарисована.
.preview.png
*/.preview.png

# Разобранные кадры тем. Готовятся из исходников при первом запуске
# и весят больше самих исходников — на «Weater Space» это 559 МБ.
.кадры/
*/.кадры/

# Настройки этой машины: путь к теме, размер окна, найденное железо.
# У каждого свои, и в общий репозиторий им не надо.
settings.json
settings.json.tmp

# Место и ключи служб погоды. Ключ — личный, координаты — тем более.
weather.json

# Значок, который программа рисует сама при создании ярлыка.
EOne screen.ico

# Библиотека датчиков: чужая, MPL 2.0, скачивается отдельно.
# См. раздел «Библиотека датчиков» в README.
*.dll

__pycache__/
*.pyc
*.pyo

# Внутренняя записка о передаче дел: устарела и писалась не для чужих глаз.
ПЕРЕДАЧА.txt

# Записка автору о том, как выкладывать. Читателям репозитория незачем.
ВЫЛОЖИТЬ НА ГИТХАБ.md

# Мусор от проверок и правок
*.bak
*.tmp
preview.png
before.png
after.png
.claude/
